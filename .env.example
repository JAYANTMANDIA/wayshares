# Firebase web app configuration (not a service-account credential)
VITE_FIREBASE_API_KEY=replace-with-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-app-id

# Server-side Firebase Admin configuration. Prefer workload identity in production.
FIREBASE_PROJECT_ID=your-project-id
# Optional for local development. Otherwise use Application Default Credentials.
# FIREBASE_SERVICE_ACCOUNT_JSON='paste your service-account JSON here locally'

# Razorpay test keys for development. Never expose the secret with a VITE_ prefix.
RAZORPAY_KEY_ID=rzp_test_replace-me
RAZORPAY_KEY_SECRET=replace-with-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret
PORT=3000

# Public URL of the deployed app — contacts must be able to open this link
APP_URL=https://yourdomain.com

# Twilio credentials for sending emergency SMS alerts to trusted contacts
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Web config
VITE_FIREBASE_API_KEY="YOUR_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"
VITE_USE_FIREBASE_EMULATOR="false"

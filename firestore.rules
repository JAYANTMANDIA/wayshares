rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // USERS COLLECTION — read by owner or admin, all writes via API only
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // DRIVERS
    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // VEHICLES
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // RIDES
    match /rides/{rideId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // BOOKINGS
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    // PAYMENTS
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // REVIEWS
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // TRACKING
    match /tracking/{trackingId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // SAFETY CONTACTS (legacy collection name kept for compatibility)
    match /safetyContacts/{contactId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // TRUSTED CONTACTS — new collection used by the live location feature
    // All writes go through the backend API (firebase-admin bypasses these rules)
    match /trustedContacts/{contactId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // LOCATION SESSIONS
    // Public read is allowed so trusted contacts can view the live map without logging in.
    // The backend API (firebase-admin) handles all writes.
    match /locationSessions/{sessionId} {
      allow read: if true;   // Public — session tokens act as unguessable secrets
      allow write: if false; // Backend-only writes via firebase-admin
    }

    // NOTIFICATIONS
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // SUPPORT TICKETS
    match /supportTickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /verificationRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /scheduledRides/{requestId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}
